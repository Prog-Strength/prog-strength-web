# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example file is documentation, not configuration, and is the only
# record of which NEXT_PUBLIC_* vars a deploy needs. Swallowed by the rule
# above it was tracked by nobody — invisible to a fresh clone, to CI, and to
# the autonomous developer worker. It holds placeholders and localhost
# defaults only; never put a real value in it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brainstorming companion artifacts
.superpowers/
