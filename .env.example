# All NEXT_PUBLIC_* vars are exposed to the browser bundle.

# Where the Go API lives. Used for the OAuth login redirect.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Where the agent service lives. Used for the /chat SSE stream.
NEXT_PUBLIC_AGENT_URL=http://localhost:8001

# Optional override for the OAuth return_to URL. If unset, the frontend
# uses window.location.origin + /auth/callback, which works for both
# local dev (http://localhost:3000) and Vercel preview/prod hostnames.
# Set this only if you need a fixed value (e.g., a custom domain that
# differs from the deployed origin).
# NEXT_PUBLIC_APP_URL=https://progstrength.fitness

# MapTiler tile key for the Topographic and Dark basemaps on activity route
# maps. OPTIONAL — leave it unset and the map falls back to the keyless
# OpenFreeMap basemap with the route and all overlays intact, so local dev and
# CI need no key at all.
#
# This key is public by construction (it ships in the browser bundle and is
# visible in the network tab). Do not treat it as a secret — protect it by
# restricting origins on the key itself in the MapTiler console:
#   http://localhost:3000/*     local dev
#   https://progstrength.fitness/*   production
#   https://*.vercel.app/*      preview deploys
# Omit the third and maps break on every preview deploy.
# NEXT_PUBLIC_MAPTILER_KEY=

# Address shown on the beta-locked page when a non-allowlisted email
# completes Google sign-in. Defaults to the project owner's personal
# address; override if you set up a dedicated alias.
# NEXT_PUBLIC_BETA_CONTACT_EMAIL=jimmy.wallace145@gmail.com
